# Build artifacts of the standalone benchmark workspace.
target/
# Run-time outputs of run-benchmarks.sh — regenerated on every run and
# machine-specific, so they must never be committed.
benchmark_identity.json
benchmark_output_*.log
# Benchmark result reports: run/machine-specific artifacts. Generate them
# locally (run-benchmarks.sh / l2_compare) or attach to the PR as CI
# artifacts — never commit them.
BENCHMARK_REPORT.md
REPORT_DIFF.md
reports/
*_REPORT.md
