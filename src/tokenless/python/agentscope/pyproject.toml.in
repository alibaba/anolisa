[build-system]
requires = ["setuptools>=77"]
build-backend = "setuptools.build_meta"

[project]
name = "anolisa-tokenless-agentscope"
version = "@VERSION@"
description = "Tokenless response-compression integration for AgentScope"
requires-python = ">=3.11"
license = "Apache-2.0"
license-files = ["LICENSE"]
dependencies = [
    "agentscope>=1.0.11,<2.1",
    "anolisa-tokenless==@VERSION@",
    # AgentScope 2.0.0 does not cap MCP and is incompatible with MCP 2.x.
    "mcp>=1.13,<2",
]

[tool.setuptools]
package-dir = { "" = "src" }

[tool.setuptools.packages.find]
where = ["src"]
