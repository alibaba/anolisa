# Rendered for the selected package layout before systemd consumes the unit.
[Unit]
Description=COSH Gateway daemon (%i)
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
User=%i
EnvironmentFile=/etc/cosh/gateway-%i.env
ExecStart="{libexecdir}/cosh-ng/cosh-gateway" serve --systemd-unit=cosh-gateway@%i.service --socket=/run/cosh-gateway-%i/gateway.sock --database=/var/lib/cosh-gateway-%i/gateway.sqlite --core-executable="{libexecdir}/cosh-ng/cosh-core" --workspace=${COSH_GATEWAY_WORKSPACE}
RuntimeDirectory=cosh-gateway-%i
RuntimeDirectoryMode=0700
StateDirectory=cosh-gateway-%i
StateDirectoryMode=0700
UMask=0077

# The system manager remains the lifecycle owner after Gateway receives SIGKILL.
KillMode=control-group
SendSIGKILL=yes
FinalKillSignal=SIGKILL
Delegate=no
TimeoutStopSec=15
Restart=on-failure
RestartSec=2

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
InaccessiblePaths=/run/user
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
