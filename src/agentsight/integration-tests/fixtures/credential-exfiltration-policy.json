{
  "policy_id": "agentloop-sensitive-data-outbound",
  "revision": 1,
  "source_patterns": [
    "/root/.aws/credentials",
    "/root/.ssh/id_rsa"
  ],
  "trusted_endpoints": [
    "10.0.0.8"
  ],
  "taint_label": "CREDENTIAL",
  "taint_ttl_secs": 900,
  "destination_scope": "public_ipv4",
  "mode": "audit",
  "classification": {
    "rule_id": "cloud-credential-to-public-network",
    "risk_type": "sensitive_data_outbound_exposure",
    "risk_subtype": "secret.cloud_access_key"
  }
}
