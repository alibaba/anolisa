[Unit]
Description=AgentSight ActPlane Enforcement Engine
Before=agentsight.service
PartOf=agentsight.service
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agentsight-enforcer
Restart=on-failure
RestartSec=2
RuntimeDirectory=agentsight
RuntimeDirectoryMode=0750
UMask=0007
Environment=AGENTSIGHT_ENFORCER_SOCKET=/run/agentsight/enforcer.sock
# Reserve only the taint and connect hooks needed for progressive exfiltration policies.
Environment=ACTPLANE_RESERVE_FILE_FLOW=1
Environment=ACTPLANE_RESERVE_NETWORK=1
NoNewPrivileges=no
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/agentsight /sys/fs/bpf
LimitMEMLOCK=infinity
TimeoutStopSec=15s

[Install]
WantedBy=multi-user.target
