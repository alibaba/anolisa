{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-os.sh/schemas/capabilities/security.code.inspect/output/v1",
  "title": "security.code.inspect/v1 output",
  "type": "object",
  "additionalProperties": false,
  "required": ["inspection"],
  "properties": {
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "findings", "scanned_bytes", "truncated"],
      "properties": {
        "verdict": {
          "enum": ["clean", "suspicious", "sensitive"]
        },
        "findings": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "category",
              "severity",
              "confidence",
              "count"
            ],
            "properties": {
              "rule_id": {
                "type": "string",
                "pattern": "^[a-z0-9._-]{1,64}$"
              },
              "category": {
                "enum": [
                  "secret",
                  "personal_data",
                  "credential",
                  "dangerous_pattern",
                  "obfuscation",
                  "other"
                ]
              },
              "severity": {
                "enum": ["info", "low", "medium", "high", "critical"]
              },
              "confidence": {
                "enum": ["low", "medium", "high"]
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            }
          }
        },
        "scanned_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "language_detected": {
          "enum": ["bash", "python", "unknown"]
        }
      }
    }
  }
}
